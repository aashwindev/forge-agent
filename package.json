{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "Editor-native coding agent whose loop runs on TrueForge",
  "version": "0.0.1",
  "publisher": "forge-agent",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "forge.ask",
        "title": "Forge: Ask Agent"
      }
    ],
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server URL (local mode)"
        },
        "forge.model": {
          "type": "string",
          "default": "openai/gpt-5-4-mini",
          "description": "Primary model, by its name in TrueForge Settings -> Models"
        },
        "forge.fallbackModel": {
          "type": "string",
          "default": "anthropic/claude-haiku-5-5",
          "description": "Second model TrueForge switches to automatically if the primary fails. Use a different provider so one bad key cannot take out both."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "latest",
    "diff": "^5.2.2",
    "zod": "^3.25.76"
  }
}
