{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "Editor-native coding agent whose loop runs on TrueForge",
  "version": "0.0.1",
  "publisher": "forge-agent",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forge.ask",
        "title": "Forge: Ask Agent (open panel)"
      },
      {
        "command": "forge.inlineEdit",
        "title": "Forge: Inline Edit Selection"
      },
      {
        "command": "forge.stop",
        "title": "Forge: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forge.undo",
        "title": "Forge: Undo Last Change"
      },
      {
        "command": "forge.undoRun",
        "title": "Forge: Undo Last Run"
      },
      {
        "command": "forge.doctor",
        "title": "Forge: Doctor"
      },
      {
        "command": "forge.acceptAll",
        "title": "Forge: Accept All Hunks",
        "icon": "$(check-all)"
      },
      {
        "command": "forge.rejectAll",
        "title": "Forge: Reject All Hunks",
        "icon": "$(close-all)"
      }
    ],
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server URL (local mode)"
        },
        "forge.model": {
          "type": "string",
          "default": "openai/gpt-5-4-mini",
          "description": "Primary model, by its name in TrueForge Settings -> Models"
        },
        "forge.fallbackModel": {
          "type": "string",
          "default": "openai/gpt-5-4-nano",
          "description": "Second model TrueForge switches to automatically if the primary fails. Use a different provider so one bad key cannot take out both."
        },
        "forge.autoApproveCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git diff",
            "git log",
            "git show"
          ],
          "description": "Command prefixes that run without asking (keep these read-only). Everything else the agent runs asks first."
        }
      }
    },
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "forge.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "forge.acceptAll",
          "when": "resourceScheme == forge-proposal",
          "group": "navigation"
        },
        {
          "command": "forge.rejectAll",
          "when": "resourceScheme == forge-proposal",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.acceptAll",
          "when": "forge.reviewing"
        },
        {
          "command": "forge.rejectAll",
          "when": "forge.reviewing"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "type": "webview",
          "id": "forge.panel",
          "name": "Agent"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "test": "esbuild test/unit.test.ts test/hunks.test.ts --bundle --platform=node --format=cjs --outdir=dist/test --log-level=warning && node --test dist/test/unit.test.js dist/test/hunks.test.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "latest",
    "diff": "^5.2.2",
    "zod": "^3.25.76"
  }
}
